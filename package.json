{
  "name": "aicareio-enterprise-platform",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "client:build": "tsc -b && vite build",
    "server:dev": "tsx watch server/server.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "build": "npm run client:build && npm run server:build",
    "start": "node dist-server/server.js",
    "zip": "powershell -Command \"Compress-Archive -Path dist,dist-server,server,src,public,package.json,README.md,tsconfig.json -DestinationPath aicareio-final-website.zip -Force\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^14.14.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
